---
// Bare section root · send anyone here back to the atlas, where the entry doors
// route you from what you hold. Base-aware; no dev listing, no production 404.
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}`} />
    <link rel="canonical" href={base} />
    <meta name="robots" content="noindex" />
    <title>OpsecAtlas</title>
  </head>
  <body><a href={base}>Go to OpsecAtlas</a></body>
</html>
