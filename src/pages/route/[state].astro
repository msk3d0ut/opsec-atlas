---
import Base from '../../layouts/Base.astro';
import RouteView from '../../components/RouteView.tsx';
import { graphData, techBySlug, plural } from '../../lib/data.ts';
import type { Technique } from '../../../pipeline/types.ts';

export function getStaticPaths() {
  return Object.values(graphData.routes)
    .filter((r) => r.steps.length > 0)
    .map((r) => ({ params: { state: r.startState } }));
}

const { state } = Astro.params;
const route = graphData.routes[state as string]!;

// Only the techniques this route references (keep the payload lean).
const techniques: Record<string, Technique> = {};
for (const step of route.steps) {
  const t = techBySlug.get(step.techniqueSlug);
  if (t) techniques[step.techniqueSlug] = t;
}
const description = `From ${route.startLabel}, follow ${route.steps.length} ordered high-yield penetration-testing moves with exact commands, expected outcomes, and next steps in OpsecAtlas.`;
---
<Base title={`You have ${route.startLabel} · OpsecAtlas`} here={route.startLabel} description={description}>
  <div class="route-head">
    <span class="label kicker">next-move engine</span>
    <h1>You have <span class="state">{route.startLabel}</span></h1>
    <p class="sub">
      {plural(route.steps.length, 'high-yield move')} from here, ordered the way the engagement runs.
      Open any move to see the exact commands.
    </p>
  </div>
  <RouteView route={route} techniques={techniques} client:load />
</Base>
