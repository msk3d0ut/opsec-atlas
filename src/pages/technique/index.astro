---
// Bare section root. No index of its own · send anyone here back to the atlas,
// where every technique is browsable by domain. Kills the dev directory listing
// and turns a would-be production 404 into a graceful hop home. Base-aware.
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}`} />
    <link rel="canonical" href={base} />
    <meta name="robots" content="noindex" />
    <title>OpsecAtlas</title>
  </head>
  <body><a href={base}>Go to OpsecAtlas</a></body>
</html>
